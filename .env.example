# Copy to .env to override defaults. Every value is optional — the API runs
# with no .env file at all. Values shown here are the built-in defaults.

# --- Environment ---
# "development" (default) or "production". In production the interactive
# docs (/docs, /redoc, /openapi.json) are disabled.
ENVIRONMENT=development

# --- App / OpenAPI metadata ---
APP_NAME=Travel Planner Mock API
APP_DESCRIPTION=Mock backend for flight search and hotel booking.
APP_VERSION=0.1.0

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Logging ---
# Minimum level emitted to the console: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# --- Storage ---
# SQLAlchemy connection URL. SQLite (default) is zero-config and used by local
# dev and the test suite; Docker injects a Postgres URL
# (postgresql+psycopg://travel:travel@db:5432/travel).
DATABASE_URL=sqlite:///travel.db

# --- Weather (live data from Open-Meteo — free, no API key needed) ---
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10.0
WEATHER_FORECAST_DAYS=3

# --- Routing (/places/route) ---
# OpenRouteService gives real road distance/duration per travel mode. It is
# free but needs an API key (sign up at openrouteservice.org — no credit
# card). Leave ORS_API_KEY blank and /places/route still works: it falls
# back to an offline straight-line (haversine) estimate.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_TIMEOUT_SECONDS=10.0

# --- CORS (JSON arrays) — wide open for local dev ---
CORS_ORIGINS=["*"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=true
