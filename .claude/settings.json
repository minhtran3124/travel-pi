{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(uv venv:*)",
      "Bash(uv pip install:*)",
      "Bash(uvicorn:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./apps/api/.env)",
      "Edit(./apps/api/.env)",
      "Read(./.env.*)",
      "Edit(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * main)",
      "Bash(git push * master)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-on-edit.sh",
            "statusMessage": "ruff --fix on edited .py…"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "vercel@anthropic-plugin-directory": true,
    "supabase@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "agent-harness": {
      "source": {
        "source": "github",
        "repo": "minhtran3124/agent-harness"
      }
    }
  }
}
