# Copy to .env to override defaults. Every value is optional — the API runs
# with no .env file at all. Values shown here are the built-in defaults.

# --- Environment ---
# "development" (default) or "production". In production the interactive
# docs (/docs, /redoc, /openapi.json) are disabled.
ENVIRONMENT=development

# --- App / OpenAPI metadata ---
APP_NAME=Travel Planner Mock API
APP_DESCRIPTION=Mock backend for flight search and hotel booking.
APP_VERSION=0.1.0

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Logging ---
# Minimum level emitted to the console: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# --- Storage ---
# SQLAlchemy connection URL. SQLite (default) is zero-config and used by local
# dev and the test suite; Docker injects a Postgres URL
# (postgresql+psycopg://travel:travel@db:5432/travel).
DATABASE_URL=sqlite:///travel.db
# For durable agent memory (cross-restart conversation continuity), point to a
# local Postgres instance — non-Postgres URLs degrade to an ephemeral MemorySaver
# that wipes graph state on every uvicorn --reload / process restart.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/travel?sslmode=disable

# --- Weather (live data from Open-Meteo — free, no API key needed) ---
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10.0
WEATHER_FORECAST_DAYS=3

# --- Routing (/places/route) ---
# OpenRouteService gives real road distance/duration per travel mode. It is
# free but needs an API key (sign up at openrouteservice.org — no credit
# card). Leave ORS_API_KEY blank and /places/route still works: it falls
# back to an offline straight-line (haversine) estimate.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
ORS_TIMEOUT_SECONDS=10.0

# --- CORS (JSON arrays) — wide open for local dev ---
CORS_ORIGINS=["*"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=true

# --- AI / Agent layer (specs/travel-agent) ---
# Provider-agnostic. Defaults run with FakeLLM (no key, no network) so leaving
# everything blank is fine for local dev and tests. Set a key only to wire a
# real model. LLM_PROVIDER: openai (default) | anthropic | google_genai.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
FAST_LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Optional: point the chat models at an OpenAI-compatible gateway/proxy instead
# of the provider's default host (leave blank to hit the provider directly). Put
# the gateway key in the matching *_API_KEY below. Example — Cline (note the
# OpenRouter-style "provider/model" names a gateway may require):
#   LLM_BASE_URL=https://api.cline.bot/api/v1
#   LLM_MODEL=openai/gpt-4.1-mini
#   FAST_LLM_MODEL=openai/gpt-4o-mini
# NB: EMBEDDING_MODEL does NOT use LLM_BASE_URL — embeddings still hit the
# provider directly, so RAG needs a real provider key (not a gateway key).
LLM_BASE_URL=
# Per-agent overrides (JSON), keyed by graph node: supervisor, planner,
# concierge, journal, booking, budget, summarize, reflection. Each entry may set
# provider / model / temperature (+ extra knobs like max_tokens); omitted fields
# fall back to LLM_PROVIDER and the node's tier model. Leave blank to use defaults.
# AGENT_LLM_CONFIGS={"concierge":{"provider":"anthropic","model":"claude-sonnet-4-6"},"supervisor":{"temperature":0.1}}
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Langfuse tracing — disabled by default. Enable + set keys in a deployment.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Agent runtime knobs.
AGENT_RECURSION_LIMIT=25
SUMMARIZE_THRESHOLD=20
