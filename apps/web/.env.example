# FastAPI backend origin (proxied at /api/be/* and used directly for agent SSE)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Trip research tab. Set to false together with the API's RESEARCH_ENABLED=false,
# which removes the research routes; on when unset, as the API is.
# NEXT_PUBLIC_RESEARCH_ENABLED=false

# Supabase auth (required — browser/server/middleware clients construct against these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# End-to-end (Playwright) test credentials — read ONLY by `pnpm e2e`, never by the app.
# The account must already exist on the Supabase project above with a confirmed email;
# the auth setup signs in with it once and saves the session to playwright/.auth (gitignored).
# When either variable is absent the e2e specs skip instead of failing.
# E2E_USER_EMAIL=e2e-user@example.com
# E2E_USER_PASSWORD=replace-with-the-e2e-account-password
