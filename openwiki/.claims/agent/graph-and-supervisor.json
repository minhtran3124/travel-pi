  "claims": [
    {
      "id": "claim_e2bbe02b164e4289b42795476467ce5c",
      "statement": "The travel agent graph is a single StateGraph whose linear prefix is START -> pii_guardrail -> load_context -> summarize -> supervisor, followed by the conditional route_tasks edge; every specialist and the synthesize node edge into reflection.",
      "evidence": [
        {
          "resource": "repo://apps/api/app/agents/graph.py#L136-L162",
          "version": "repo-lines-v1:sha256:9c80fe7a11ac324d77a1a85e170bab4d32aadb7c48a21478bb0160c9f35a1359:"
        }
      ]
    },
    {
      "id": "claim_0ef63b6cd7404ef08adbc80239f13041",
      "statement": "The PII guardrail is registered as the first graph node so it runs before any model call, checkpointer write, or memory extraction observes the turn.",
      "evidence": [
        {
          "resource": "repo://apps/api/app/agents/graph.py#L92-L96",
          "version": "repo-lines-v1:sha256:e9523b2f4691f6a43a1ec9a9dd727ec624c7dad06e6f8440b3407fdec17e5b5d:"
        }
      ]
    },
    {
      "id": "claim_f17b5f08f4ea45f0855c8b98df78a875",
      "statement": "Non-specialist nodes get a fixed model chosen at build time while specialist nodes get a deferred per-request resolver that memoizes models per ctx_model hint; injected test fakes override the whole tier regardless of the hint.",
