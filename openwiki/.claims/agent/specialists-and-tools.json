    {
      "id": "claim_2d851715447848a5a0e20ec68847d2b7",
      "statement": "Each specialist is compiled by build_subagent as a ReAct subgraph with assistant, trip_guard and tools nodes; the assistant resolves its model per request, filters the episodic tool by AgentContext.allow_episodic, and layers summary, reply language, date grounding and the task note onto the build-time style+domain prompt in that fixed order.",
      "evidence": [
        {
          "resource": "repo://apps/api/app/agents/subagents/_base.py#L218-L296",
          "version": "repo-lines-v1:sha256:2ee4b123b582867f9822f70bc048319bcd9553f10fc0156410cc64e83d04e316:"
        }
      ]
    },
    {
      "id": "claim_4b3c5ff1996748da94d5089e16484bb3",
      "statement": "The set of tools that require an active trip is derived from InjectedState(\"trip_id\") annotations rather than a hand-maintained list; a tool whose annotations cannot be read is excluded from the guard with a warning instead of blocking graph build.",
