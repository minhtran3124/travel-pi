          "version": "repo-lines-v1:sha256:0ea055f38f9bf4a430bb3d3f662976386bd55294ad0a880b2cf0be6e74297c6d:"
        }
      ]
    },
    {
      "id": "claim_ec7c1bc9bca64705957baabdc4f778ff",
      "statement": "Hotel capacity is derived deterministically: total rooms from a hash of the hotel id, occupancy from star rating, free rooms from a hash of hotel id and dates so some combinations are sold out, availability requires both free rooms and physical capacity for the party, and count_nights raises unless check-out is strictly after check-in.",
      "evidence": [
        {
          "resource": "repo://apps/api/app/services/hotel_service.py#L103-L136",
          "version": "repo-lines-v1:sha256:c7b793be934d7e8dde85e5ef8cbbddf689819fdb53ffc6f9f3b2819e0eef236b:"
