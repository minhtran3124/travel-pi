    {
      "id": "claim_9e814f8e4d2b41d793d9c4ab3f7c40e6",
      "statement": "Flights are generated on demand and never persisted: an MD5 of origin, destination and date seeds the RNG, airlines are drawn in seed position order, ids are UUID5 of a route/date/index slug, and the order of RNG calls is contractual because reordering reissues every flight id.",
      "evidence": [
        {
          "resource": "repo://apps/api/app/services/flight_service.py#L1-L1",
          "version": "repo-lines-v1:sha256:1f98539558c66d2302bc48708f889631606c5db4c9ec4802d47239c18fd4429d:"
        },
        {
          "resource": "repo://apps/api/app/services/flight_service.py#L42-L105",
          "version": "repo-lines-v1:sha256:b302a33a3b4e40d9f6d510080368551499ce0a8260fc51fddc273aa50b60ecd7:"
        }
      ]
    },
    {
      "id": "claim_2e1ab95b7b2c448d92e93d943ad396ff",
      "statement": "The flight index records the search parameters behind every issued flight id with a race-safe ON CONFLICT DO NOTHING so a booking can re-resolve an id from an earlier request or before a restart by re-running the generator.",
      "evidence": [
        {
          "resource": "repo://apps/api/app/db/models/flight_index.py#L9-L15",
          "version": "repo-lines-v1:sha256:1f96f2a449c8b7ceb3db882d64c93d0a00730260dd55fae3623fb667783f0d9b:"
        },
        {
