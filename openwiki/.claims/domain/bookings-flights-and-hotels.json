    {
      "id": "claim_b77cdd954eeb4f57bbdea76021d1cb61",
      "statement": "A booking request with an idempotency key replays the owner's prior booking before any other work, an optional trip_id must belong to the caller or the request is a 404, and the replay ignores a different trip_id on the second request.",
